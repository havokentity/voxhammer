# Build output
build/
dist/
out/

# vcpkg (manifest mode installs here per-build-tree; toolchain also drops a
# copy at the source root on some flows)
vcpkg_installed/
.vcpkg-root

# CMake local
CMakeUserPresets.json
compile_commands.json

# IDEs / editors
.idea/
.vs/
.vscode/
.fleet/
.cache/
*.user

# Compiled / linked artifacts
*.obj
*.o
*.lib
*.a
*.dll
*.exe
*.pdb
*.ilk
*.exp

# Build/run logs + scratch
*.log

# Vendored SDK source + build trees (pinned/documented, not committed).
# PhysX 5 is acquired by a documented shallow clone into thirdparty/physx and
# built out-of-source into thirdparty/physx_build -- see thirdparty/README.md.
# The pin (repo/tag/commit) + the build patch live in the tracked README +
# thirdparty/physx-voxhammer.patch, NOT the multi-GB source tree.
/thirdparty/physx/
/thirdparty/physx_build*/

# Runtime-generated config + state (the engine regenerates these)
cvars.toml
keybindings.toml
console_history.txt

# Claude Code session state
.claude/

# OS cruft
.DS_Store
Thumbs.db
